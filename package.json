{
  "name": "mangascraper",
  "version": "1.0.1",
  "description": "MangaScraper - Baixe capítulos de mangá do MangaDex e converta em PDF",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder build --win",
    "build:mac": "electron-builder build --mac",
    "build:linux": "electron-builder build --linux",
    "build": "electron-builder build --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "productName": "MangaScraper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!dist/**/*",
      "!*.md"
    ],
    "asar": {
      "smartUnpack": true
    },
    "asarUnpack": [
      "app.py",
      "flask_wrapper.py",
      "scraper.py",
      "app.py",
      "**/*.py",
      "**/ui/**"
    ],
    "mac": {
      "target": "dmg",
      "icon": "icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png",
      "category": "Graphics"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}